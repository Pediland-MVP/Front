{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",

  "globalEnv": ["NEXT_PUBLIC_*"],
  "globalDependencies": [".env", ".env.local", ".env.*.local"],

  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },

    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "turbo.json"],
      "outputs": [".next/**", "dist/**", "build/**", "out/**"]
    },

    "start": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build"]
    },

    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },

    "typecheck": {
      "dependsOn": ["^typecheck"]
    },

    "test": {
      "cache": false
    },

    "pkg-build": {
      "dependsOn": ["^pkg-build"],
      "outputs": ["dist/**", "build/**"]
    },

    "clean": {
      "cache": false
    }
  }
}
