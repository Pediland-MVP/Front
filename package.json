{
    "name": "befroosh-front-monorepo",
    "private": true,
    "packageManager": "pnpm@10.4.1",
    "engines": {
        "node": ">=20.10"
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "turbo run dev --parallel",
        "ui": "cd packages/ui && pnpm dlx shadcn@latest",
        "build": "turbo run build",
        "start": "turbo run start",
        "lint": "turbo run lint",
        "typecheck": "turbo run typecheck",
        "clean": "turbo run clean && rimraf node_modules .turbo",
        "pkg-build": "turbo run pkg-build"
    },
    "devDependencies": {
        "@types/react": "^18.3.24",
        "@types/react-dom": "^18.3.7",
        "autoprefixer": "^10.4.21",
        "eslint": "^9.32.0",
        "prettier": "^3.6.2",
        "rimraf": "^5.0.10",
        "tsup": "^8.5.0",
        "turbo": "^2.5.6",
        "typescript": "5.8.2"
    }
}