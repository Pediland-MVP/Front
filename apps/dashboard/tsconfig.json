{
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"],
    "target": "ES2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": false,
    "skipLibCheck": true,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "noPropertyAccessFromIndexSignature": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "isolatedModules": true,
    "noEmit": true,
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": false,
    "baseUrl": "./src",
    "paths": {
      "@/*": ["./*"],
      "@/components/ui": ["../../../packages/ui/src/components/ui/index.ts"],
      "@/components/ui/*": ["../../../packages/ui/src/components/ui/*"],
      "@/components/ui-custom/*": ["../../../packages/ui/src/components/ui-custom/*"],
      "@/lib/utils": ["../../../packages/ui/src/lib/utils.ts"],
      "@/components/automation-builder": ["../../../packages/ui/src/automation-builder/index.ts"],
      "@/components/automation-builder/*": ["../../../packages/ui/src/automation-builder/*"],
      "@components/*": ["./components/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
