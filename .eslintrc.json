{
  "extends": [
    "next/core-web-vitals",
    "plugin:storybook/recommended"
  ],
  "settings": {
    "import/resolver": {
      "typescript": {
        "project": "./"
      },
      "node": {
        "paths": [
          "."
        ],
        "extensions": [
          ".js",
          ".jsx",
          ".ts",
          ".tsx"
        ]
      }
    }
  },
  "rules": {
    "no-console": "warn",
    "import/no-unresolved": "error"
  }
}