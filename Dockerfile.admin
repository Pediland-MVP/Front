# syntax=docker/dockerfile:1

# ---- build stage: install + build + prod-prune in ONE layer (small disk) ----
FROM node:24 AS build
WORKDIR /app
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV CI=true
RUN corepack enable

ARG NEXT_PUBLIC_BACK_API_URL
ENV NEXT_PUBLIC_BACK_API_URL=$NEXT_PUBLIC_BACK_API_URL \
    NEXT_TELEMETRY_DISABLED=1

COPY . .
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile \
 && pnpm exec turbo run build --filter=admin \
 && pnpm install --frozen-lockfile --prod --ignore-scripts

# ---- runtime stage: slim base, runs `next start` ----
FROM node:24-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
RUN corepack enable
COPY --from=build /app /app

EXPOSE 3000
CMD ["pnpm", "--filter", "admin", "start"]
